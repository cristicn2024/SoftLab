# Copia este archivo como .env (npm run dev lo hace solo si no existe).
# Esta URL coincide con el MySQL del docker-compose (docker compose up -d db).
# Si usas un MySQL propio, cambia usuario, contraseña y puerto.
# La base softlab_db no hace falta crearla: la crea prisma db push.
DATABASE_URL="mysql://root:78357Cas@localhost:3306/softlab_db"

PORT=4000

# Orígenes del frontend permitidos por CORS, separados por coma.
# Usa el origen exacto del frontend. En producción se requiere HTTPS.
ORIGENES_PERMITIDOS="http://localhost:5173,http://localhost:8080"

# HU 7.5. Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Obligatorio en producción y compartido por todas las instancias. En desarrollo,
# si se deja vacío, el servidor genera un secreto temporal en cada arranque.
SESION_SECRETO=""
SESION_MINUTOS=480
# Se fuerza a true si NODE_ENV=production. false permite HTTP local.
SESION_COOKIE_SECURE=false
# Límite por cuenta y por IP en una ventana fija, compartido en MySQL.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
