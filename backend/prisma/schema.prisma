// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  inactive
}

enum UserRole {
  admin
  receptionist
  chemist
  doctor
}

enum Gender {
  M
  F
  Other
}

enum OrderStatus {
  pending
  in_process
  completed
  cancelled
}

enum SampleStatus {
  collected
  received
  rejected
  processed
}

enum ResultStatus {
  captured
  validated
}

model Tenant {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  subdomain   String       @unique @db.VarChar(50)
  status      TenantStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")

  branches    Branch[]
  users       User[]
  patients    Patient[]
  tests       TestCatalog[]
  orders      Order[]
  samples     Sample[]
  testResults TestResult[]
  practitioners Practitioner[]
  parameters TestParameter[]
  referenceRanges ReferenceRange[]
  instructionConfirmations InstructionConfirmation[]
  instructionDeliveries InstructionDelivery[]
  criticalNotifications CriticalNotification[]
  instructions StudyInstruction[]

  @@map("tenants")
}

model Branch {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  orders    Order[]

  @@map("branches")
}

model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  branchId     Int?     @map("branch_id")
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  validatedResults TestResult[]
  instructionConfirmations InstructionConfirmation[]
  instructionDeliveries InstructionDelivery[]
  criticalNotifications CriticalNotification[]

  @@map("users")
}

model Patient {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  birthDate DateTime @map("birth_date") @db.Date
  gender    Gender
  patientCode String? @map("patient_code") @db.VarChar(30)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([tenantId, patientCode])
  @@map("patients")
}

model TestCatalog {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  price          Decimal  @db.Decimal(10, 2)
  sampleType     String   @map("sample_type") @db.VarChar(50)
  referenceRange String?  @map("reference_range") @db.Text
  externalLab    String?  @map("external_lab") @db.VarChar(150)
  turnaroundHours Int?    @map("turnaround_hours")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  instructions   StudyInstruction[]
  parameters     TestParameter[]
  ranges         ReferenceRange[]

  @@unique([tenantId, code], name: "uq_tenant_test_code")
  @@map("test_catalog")
}

model Order {
  id          Int         @id @default(autoincrement())
  tenantId    Int         @map("tenant_id")
  branchId    Int         @map("branch_id")
  patientId   Int         @map("patient_id")
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  paidAmount  Decimal     @default(0.00) @map("paid_amount") @db.Decimal(10, 2)
  status      OrderStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at")
  folio       String?     @unique @db.VarChar(40)
  physicianId Int?        @map("physician_id")
  physician   Practitioner? @relation(fields: [physicianId], references: [id], onDelete: SetNull)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  items       OrderItem[]
  samples     Sample[]
  instructionConfirmation InstructionConfirmation?
  instructionDeliveries InstructionDelivery[]

  @@map("orders")
}

model OrderItem {
  id      Int     @id @default(autoincrement())
  orderId Int     @map("order_id")
  testId  Int     @map("test_id")
  price   Decimal @db.Decimal(10, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test        TestCatalog  @relation(fields: [testId], references: [id])
  testResults TestResult[]

  @@map("order_items")
}

model Sample {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  orderId     Int          @map("order_id")
  barcode     String       @unique @db.VarChar(100)
  status      SampleStatus @default(collected)
  collectedAt DateTime?    @map("collected_at")
  receivedAt DateTime?     @map("received_at")
  sampleDescription String? @map("sample_description") @db.VarChar(150)
  equipment String? @db.VarChar(150)
  capturedByName String? @map("captured_by_name") @db.VarChar(150)
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("samples")
}

model TestResult {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  orderItemId Int          @map("order_item_id")
  resultValue String?      @map("result_value") @db.VarChar(255)
  isAlert     Boolean      @default(false) @map("is_alert")
  status      ResultStatus @default(captured)
  validatedBy Int?         @map("validated_by")
  validatedAt DateTime?    @map("validated_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  flag        String?      @db.VarChar(2)
  parameterId Int?         @map("parameter_id")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  validator   User?        @relation(fields: [validatedBy], references: [id], onDelete: SetNull)
  parameter   TestParameter? @relation(fields: [parameterId], references: [id], onDelete: SetNull)
  criticalNotifications CriticalNotification[]

  @@unique([orderItemId, parameterId])
  @@map("test_results")
}

enum InstructionType {
  fasting
  first_urine
  medication
  text
}

enum DeliveryChannel {
  whatsapp
  email
}

enum CriticalRecipient {
  doctor
  patient
}

enum CriticalContactMethod {
  phone
  email
  whatsapp
  in_person
}

model Practitioner {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  fullName String @map("full_name") @db.VarChar(150)
  specialty String? @db.VarChar(120)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]
  @@unique([tenantId, fullName])
  @@map("practitioners")
}

model StudyInstruction {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  testId Int @map("test_id")
  type InstructionType
  minHours Int? @map("min_hours")
  maxHours Int? @map("max_hours")
  text String @db.VarChar(500)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  test TestCatalog @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@unique([testId, type, text])
  @@map("study_instructions")
}

model InstructionConfirmation {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  orderId Int @unique @map("order_id")
  userId Int? @map("user_id")
  branchId Int @map("branch_id")
  observation String? @db.VarChar(500)
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("instruction_confirmations")
}

model InstructionDelivery {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  orderId Int @map("order_id")
  userId Int? @map("user_id")
  channel DeliveryChannel
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("instruction_deliveries")
}

model TestParameter {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  testId Int @map("test_id")
  name String @db.VarChar(150)
  unit String? @db.VarChar(30)
  sortOrder Int @default(0) @map("sort_order")
  qualitativeExpected String? @map("qualitative_expected") @db.VarChar(100)
  previousValue String? @map("previous_value") @db.VarChar(255)
  previousDate String? @map("previous_date") @db.VarChar(40)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  test TestCatalog @relation(fields: [testId], references: [id], onDelete: Cascade)
  ranges ReferenceRange[]
  results TestResult[]
  @@unique([testId, name])
  @@map("test_parameters")
}

model ReferenceRange {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  testId Int @map("test_id")
  parameterId Int? @map("parameter_id")
  gender Gender?
  minAgeYears Int? @map("min_age_years")
  maxAgeYears Int? @map("max_age_years")
  low Decimal? @db.Decimal(12, 4)
  high Decimal? @db.Decimal(12, 4)
  lowInclusive Boolean @default(true) @map("low_inclusive")
  highInclusive Boolean @default(true) @map("high_inclusive")
  criticalLow Decimal? @map("critical_low") @db.Decimal(12, 4)
  criticalHigh Decimal? @map("critical_high") @db.Decimal(12, 4)
  criticalLowInclusive Boolean @default(false) @map("critical_low_inclusive")
  criticalHighInclusive Boolean @default(false) @map("critical_high_inclusive")
  display String @db.VarChar(100)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  test TestCatalog @relation(fields: [testId], references: [id], onDelete: Cascade)
  parameter TestParameter? @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  @@map("reference_ranges")
}

model CriticalNotification {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  resultId Int @map("result_id")
  userId Int? @map("user_id")
  branchId Int @map("branch_id")
  recipient CriticalRecipient
  recipientName String @map("recipient_name") @db.VarChar(150)
  contactMethod CriticalContactMethod @map("contact_method")
  notifiedAt DateTime @map("notified_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("critical_notifications")
}
