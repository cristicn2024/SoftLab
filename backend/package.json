{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "predev": "npm run db:preparar",
    "dev": "nest start --watch",
    "dev:express": "tsx watch src/index.ts",
    "build": "nest build",
    "start": "node dist/main",
    "test": "tsx --test \"src/modules/**/*.test.ts\"",
    "test:screens": "tsx --test --test-concurrency=1 \"src/__tests__/screens/**/*.test.ts\" && jest --runInBand --testMatch \"**/__tests__/screens/**/*.spec.ts\"",
    "test:nest": "jest --testMatch \"**/modules/**/*.spec.ts\"",
    "test:all": "npm test && npm run test:nest && npm run test:screens",
    "test:jest": "jest",
    "db:preparar": "node scripts/preparar-bd.cjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "db:seed:cashcut": "tsx prisma/seed.ts corte-caja",
    "seed:hu-5-2-6-2": "tsx prisma/seed.ts hu-5-2-6-2",
    "seed:hu-6-1": "tsx prisma/seed.ts hu-6-1",
    "seed:hu55": "tsx prisma/seed.ts hu-5-5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "puppeteer": "^25.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
