// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  inactive
}

enum UserRole {
  admin
  receptionist
  chemist
  doctor
}

enum Gender {
  M
  F
  Other
}

enum OrderStatus {
  pending
  in_process
  completed
  cancelled
}

enum SampleStatus {
  collected
  received
  rejected
  processed
}

enum PaymentMethod {
  cash
  card
  transfer
}

enum ResultStatus {
  captured
  validated
}

model Tenant {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(150)
  subdomain       String           @unique @db.VarChar(50)
  status          TenantStatus     @default(active)
  createdAt       DateTime         @default(now()) @map("created_at")

  branches        Branch[]
  users           User[]
  patients        Patient[]
  tests           TestCatalog[]
  orders          Order[]
  samples         Sample[]
  testResults     TestResult[]
  payments        Payment[]
  paymentLogs     PaymentLog[]
  reportTemplates ReportTemplate[]
  orderReports    OrderReport[]
  doctors         Doctor[]
  profileCatalogs ProfileCatalog[]

  @@map("tenants")
}

model Branch {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  orders    Order[]
  reportTemplates ReportTemplate[]
  payments  Payment[]

  @@map("branches")
}

model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  branchId     Int?     @map("branch_id")
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  validatedResults TestResult[]

  @@map("users")
}

model Patient {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  birthDate DateTime @map("birth_date") @db.Date
  gender    Gender
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("patients")
}

model TestCatalog {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  price          Decimal  @db.Decimal(10, 2)
  sampleType     String   @map("sample_type") @db.VarChar(50)
  referenceRange String?  @map("reference_range") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  profileTests ProfileTest[]

  @@unique([tenantId, code], name: "uq_tenant_test_code")
  @@map("test_catalog")
}

model Order {
  id          Int         @id @default(autoincrement())
  tenantId    Int         @map("tenant_id")
  branchId    Int         @map("branch_id")
  patientId   Int         @map("patient_id")
  doctorId    Int?        @map("doctor_id")
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  paidAmount  Decimal     @default(0.00) @map("paid_amount") @db.Decimal(10, 2)
  status      OrderStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at")

  // HU 5.3 · Total y estado de pago
  doctorName           String?   @map("doctor_name") @db.VarChar(150)
  discountPercent      Int       @default(0) @map("discount_percent")
  discountReason       String?   @map("discount_reason") @db.VarChar(255)
  discountAuthorizedBy String?   @map("discount_authorized_by") @db.VarChar(150)
  invoiceRfc           String?   @map("invoice_rfc") @db.VarChar(13)
  invoiceName          String?   @map("invoice_name") @db.VarChar(255)
  invoiceZip           String?   @map("invoice_zip") @db.VarChar(5)
  invoiceUse           String?   @map("invoice_use") @db.VarChar(100)
  resultsDeliveredAt   DateTime? @map("results_delivered_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  samples      Sample[]
  orderReports OrderReport[]
  payments    Payment[]
  paymentLogs PaymentLog[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  testId    Int?     @map("test_id")
  profileId Int?     @map("profile_id")
  price     Decimal  @db.Decimal(10, 2)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test        TestCatalog?    @relation(fields: [testId], references: [id], onDelete: SetNull)
  profile     ProfileCatalog? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  testResults TestResult[]

  @@map("order_items")
}

model Sample {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  orderId     Int          @map("order_id")
  barcode     String       @unique @db.VarChar(100)
  status      SampleStatus @default(collected)
  collectedAt DateTime?    @map("collected_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("samples")
}

model TestResult {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  orderItemId Int          @map("order_item_id")
  resultValue String?      @map("result_value") @db.VarChar(255)
  isAlert     Boolean      @default(false) @map("is_alert")
  status      ResultStatus @default(captured)
  validatedBy Int?         @map("validated_by")
  validatedAt DateTime?    @map("validated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  validator   User?        @relation(fields: [validatedBy], references: [id], onDelete: SetNull)

  @@map("test_results")
}

model ReportTemplate {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  name          String   @db.VarChar(100)
  studyType     String?  @map("study_type") @db.VarChar(50) // Ej: 'biometria', 'urianalisis' o NULL para general
  branchId      Int?     @map("branch_id")
  version       Int      @default(1)
  isDefault     Boolean  @default(false) @map("is_default")
  
  // Branding y Personalización
  primaryColor  String   @default("#0f766e") @map("primary_color") @db.VarChar(10)
  logoUrl       String?  @map("logo_url") @db.VarChar(255)
  watermarkUrl  String?  @map("watermark_url") @db.VarChar(255)
  signatureUrl  String?  @map("signature_url") @db.VarChar(255)
  chemistName   String?  @map("chemist_name") @db.VarChar(150)
  chemistCedula String?  @map("chemist_cedula") @db.VarChar(50)
  
  headerText    String?  @map("header_text") @db.Text
  footerText    String?  @map("footer_text") @db.Text
  disclaimer    String?  @db.Text
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderReports  OrderReport[]

  @@map("report_templates")
}

model OrderReport {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  orderId    Int      @map("order_id")
  templateId Int      @map("template_id")
  qrToken    String   @unique @map("qr_token") @db.VarChar(100)
  pdfUrl     String?  @map("pdf_url") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template   ReportTemplate @relation(fields: [templateId], references: [id])

  @@map("order_reports")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(150)
  cedula    String?  @db.VarChar(50)
  specialty String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("doctors")
}

model ProfileCatalog {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tests  ProfileTest[]
  items  OrderItem[]

  @@map("profile_catalogs")
}

model ProfileTest {
  profileId Int @map("profile_id")
  testId    Int @map("test_id")

  profile ProfileCatalog @relation(fields: [profileId], references: [id], onDelete: Cascade)
  test    TestCatalog    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([profileId, testId])
  @@map("profile_tests")
}

// HU 5.3 · Pagos de una orden. Se registran en la caja de la sucursal donde se cobra.
// Un pago no se borra: se marca como cancelado con motivo y usuario.
model Payment {
  id           Int           @id @default(autoincrement())
  tenantId     Int           @map("tenant_id")
  orderId      Int           @map("order_id")
  branchId     Int           @map("branch_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  reference    String?       @db.VarChar(100)
  createdBy    String        @map("created_by") @db.VarChar(150)
  createdAt    DateTime      @default(now()) @map("created_at")
  cancelled    Boolean       @default(false)
  cancelReason String?       @map("cancel_reason") @db.VarChar(255)
  cancelledBy  String?       @map("cancelled_by") @db.VarChar(150)
  cancelledAt  DateTime?     @map("cancelled_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])

  @@map("payments")
}

// HU 5.3 · Bitácora del cobro: pagos, descuentos, cancelaciones y datos de factura.
model PaymentLog {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  orderId   Int      @map("order_id")
  userName  String   @map("user_name") @db.VarChar(150)
  action    String   @db.VarChar(100)
  detail    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_logs")
}