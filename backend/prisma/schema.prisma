generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  inactive
}

enum UserRole {
  admin
  receptionist
  chemist
  doctor
}

enum Gender {
  M
  F
  Other
}

enum OrderStatus {
  pending
  in_process
  completed
  cancelled
}

enum SampleStatus {
  collected
  received
  rejected
  processed
}

enum ResultStatus {
  captured
  validated
}

enum PaymentMethod {
  cash
  card
  transfer
}

enum CashCutStatus {
  open
  closed
}

enum CashCutShift {
  matutino
  vespertino
  nocturno
}

model Tenant {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  subdomain   String       @unique @db.VarChar(50)
  status      TenantStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")

  branches        Branch[]
  users           User[]
  patients        Patient[]
  tests           TestCatalog[]
  orders          Order[]
  samples         Sample[]
  testResults     TestResult[]
  doctors         Doctor[]
  reportTemplates ReportTemplate[]
  orderReports    OrderReport[]
  profileCatalogs ProfileCatalog[]
  cashCuts        CashCut[]
  payments        Payment[]
  paymentLogs     PaymentLog[]

  @@map("tenants")
}

model Branch {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  orders          Order[]
  reportTemplates ReportTemplate[]
  cashCuts        CashCut[]
  payments        Payment[]

  @@index([tenantId], map: "branches_tenant_id_fkey")
  @@map("branches")
}

model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  branchId     Int?     @map("branch_id")
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  validatedResults TestResult[]
  cashierOrders   Order[]      @relation("OrderCashier")
  cashierCuts     CashCut[]    @relation("CashCutCashier")
  closedCuts      CashCut[]    @relation("CashCutClosedBy")
  payments        Payment[]    @relation("PaymentCashier")

  @@index([branchId], map: "users_branch_id_fkey")
  @@index([tenantId], map: "users_tenant_id_fkey")
  @@map("users")
}

model Patient {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  birthDate DateTime @map("birth_date") @db.Date
  gender    Gender
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId], map: "patients_tenant_id_fkey")
  @@map("patients")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(150)
  cedula    String?  @db.VarChar(50)
  specialty String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId], map: "doctors_tenant_id_fkey")
  @@map("doctors")
}

model TestCatalog {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(150)
  price             Decimal  @db.Decimal(10, 2)
  sampleType        String   @map("sample_type") @db.VarChar(50)
  genderRestriction String   @default("BOTH") @map("gender_restriction") @db.VarChar(10)
  referenceRange    String?  @map("reference_range") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  profileTests ProfileTest[]

  @@unique([tenantId, code], name: "uq_tenant_test_code")
  @@map("test_catalog")
}

model ProfileCatalog {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  status      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tests      ProfileTest[]

  @@index([tenantId], map: "profile_catalogs_tenant_id_fkey")
  @@map("profile_catalogs")
}

model ProfileTest {
  profileId Int @map("profile_id")
  testId    Int @map("test_id")

  profile ProfileCatalog @relation(fields: [profileId], references: [id], onDelete: Cascade)
  test    TestCatalog    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([profileId, testId])
  @@index([testId], map: "profile_tests_test_id_fkey")
  @@map("profile_tests")
}

model Order {
  id             Int         @id @default(autoincrement())
  tenantId       Int         @map("tenant_id")
  branchId       Int         @map("branch_id")
  patientId      Int         @map("patient_id")
  doctorId       Int?        @map("doctor_id")
  cashierId      Int?        @map("cashier_id")
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  paidAmount     Decimal     @default(0.00) @map("paid_amount") @db.Decimal(10, 2)
  discountAmount Decimal     @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  status         OrderStatus @default(pending)
  folio          String?     @unique @db.VarChar(30)
  createdAt      DateTime    @default(now()) @map("created_at")

  // HU 5.3 · Total y estado de pago
  doctorName           String?   @map("doctor_name") @db.VarChar(150)
  discountPercent      Int       @default(0) @map("discount_percent")
  discountReason       String?   @map("discount_reason") @db.VarChar(255)
  discountAuthorizedBy String?   @map("discount_authorized_by") @db.VarChar(150)
  invoiceRfc           String?   @map("invoice_rfc") @db.VarChar(13)
  invoiceName          String?   @map("invoice_name") @db.VarChar(255)
  invoiceZip           String?   @map("invoice_zip") @db.VarChar(5)
  invoiceUse           String?   @map("invoice_use") @db.VarChar(100)
  resultsDeliveredAt   DateTime? @map("results_delivered_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  cashier      User?         @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  samples      Sample[]
  orderReports OrderReport[]
  payments     Payment[]
  paymentLogs  PaymentLog[]

  @@index([branchId], map: "orders_branch_id_fkey")
  @@index([doctorId], map: "orders_doctor_id_fkey")
  @@index([patientId], map: "orders_patient_id_fkey")
  @@index([tenantId], map: "orders_tenant_id_fkey")
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  testId    Int?    @map("test_id")
  profileId Int?    @map("profile_id")
  price     Decimal @db.Decimal(10, 2)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test        TestCatalog?   @relation(fields: [testId], references: [id])
  profile     ProfileCatalog? @relation(fields: [profileId], references: [id])
  testResults TestResult[]

  @@index([orderId], map: "order_items_order_id_fkey")
  @@index([profileId], map: "order_items_profile_id_fkey")
  @@index([testId], map: "order_items_test_id_fkey")
  @@map("order_items")
}

model Sample {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  orderId     Int          @map("order_id")
  barcode     String       @unique @db.VarChar(100)
  status      SampleStatus @default(collected)
  collectedAt DateTime?    @map("collected_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "samples_order_id_fkey")
  @@index([tenantId], map: "samples_tenant_id_fkey")
  @@map("samples")
}

model TestResult {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  orderItemId Int          @map("order_item_id")
  resultValue String?      @map("result_value") @db.VarChar(255)
  isAlert     Boolean      @default(false) @map("is_alert")
  status      ResultStatus @default(captured)
  validatedBy Int?         @map("validated_by")
  validatedAt DateTime?    @map("validated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  validator User?     @relation(fields: [validatedBy], references: [id], onDelete: SetNull)

  @@index([orderItemId], map: "test_results_order_item_id_fkey")
  @@index([tenantId], map: "test_results_tenant_id_fkey")
  @@index([validatedBy], map: "test_results_validated_by_fkey")
  @@map("test_results")
}

model ReportTemplate {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  name          String   @db.VarChar(100)
  studyType     String?  @map("study_type") @db.VarChar(50)
  branchId      Int?     @map("branch_id")
  version       Int      @default(1)
  isDefault     Boolean  @default(false) @map("is_default")
  primaryColor  String   @default("#0f766e") @map("primary_color") @db.VarChar(10)
  logoUrl       String?  @map("logo_url") @db.VarChar(255)
  watermarkUrl  String?  @map("watermark_url") @db.VarChar(255)
  signatureUrl  String?  @map("signature_url") @db.VarChar(255)
  chemistName   String?  @map("chemist_name") @db.VarChar(150)
  chemistCedula String?  @map("chemist_cedula") @db.VarChar(50)
  headerText    String?  @map("header_text") @db.Text
  footerText    String?  @map("footer_text") @db.Text
  disclaimer    String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderReports OrderReport[]

  @@index([branchId], map: "report_templates_branch_id_fkey")
  @@index([tenantId], map: "report_templates_tenant_id_fkey")
  @@map("report_templates")
}

model OrderReport {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  orderId    Int      @map("order_id")
  templateId Int      @map("template_id")
  qrToken    String   @unique @map("qr_token") @db.VarChar(100)
  pdfUrl     String?  @map("pdf_url") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template ReportTemplate @relation(fields: [templateId], references: [id])

  @@index([orderId], map: "order_reports_order_id_fkey")
  @@index([templateId], map: "order_reports_template_id_fkey")
  @@index([tenantId], map: "order_reports_tenant_id_fkey")
  @@map("order_reports")
}

// HU 5.3 · Pagos de una orden. Un pago no se borra: se marca como cancelado con motivo y usuario.
// HU 5.4 · cashierId y cashCutId ligan el pago con el cajero y con el corte de caja.
model Payment {
  id           Int           @id @default(autoincrement())
  tenantId     Int           @map("tenant_id")
  branchId     Int           @map("branch_id")
  orderId      Int           @map("order_id")
  cashierId    Int?          @map("cashier_id")
  cashCutId    Int?          @map("cash_cut_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  reference    String?       @db.VarChar(100)
  createdBy    String?       @map("created_by") @db.VarChar(150)
  createdAt    DateTime      @default(now()) @map("created_at")
  cancelled    Boolean       @default(false)
  cancelReason String?       @map("cancel_reason") @db.VarChar(255)
  cancelledBy  String?       @map("cancelled_by") @db.VarChar(150)
  cancelledAt  DateTime?     @map("cancelled_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch   @relation(fields: [branchId], references: [id])
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashier User?    @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  cashCut CashCut? @relation(fields: [cashCutId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([cashierId])
  @@index([orderId])
  @@index([cashCutId])
  @@index([tenantId, branchId, createdAt])
  @@map("payments")
}

// HU 5.3 · Bitácora del cobro: pagos, descuentos, cancelaciones y datos de factura.
model PaymentLog {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  orderId   Int      @map("order_id")
  userName  String   @map("user_name") @db.VarChar(150)
  action    String   @db.VarChar(100)
  detail    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_logs")
}

model CashCut {
  id                 Int           @id @default(autoincrement())
  tenantId           Int           @map("tenant_id")
  branchId           Int           @map("branch_id")
  cashierId          Int           @map("cashier_id")
  shift              CashCutShift
  cutDate            DateTime      @map("cut_date") @db.Date
  periodStart        DateTime      @map("period_start")
  periodEnd          DateTime      @map("period_end")
  status             CashCutStatus @default(open)

  cashTotal          Decimal       @default(0.00) @map("cash_total") @db.Decimal(12, 2)
  cardTotal          Decimal       @default(0.00) @map("card_total") @db.Decimal(12, 2)
  transferTotal      Decimal       @default(0.00) @map("transfer_total") @db.Decimal(12, 2)
  discountsTotal     Decimal       @default(0.00) @map("discounts_total") @db.Decimal(12, 2)
  ordersCount        Int           @default(0) @map("orders_count")
  cancellationsCount Int           @default(0) @map("cancellations_count")
  expectedCash       Decimal       @default(0.00) @map("expected_cash") @db.Decimal(12, 2)

  countedCash        Decimal?      @map("counted_cash") @db.Decimal(12, 2)
  difference         Decimal?      @db.Decimal(12, 2)
  observation        String?       @db.Text
  snapshotJson       String?       @map("snapshot_json") @db.LongText
  closedById         Int?          @map("closed_by_id")
  closedAt           DateTime?     @map("closed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch  @relation(fields: [branchId], references: [id])
  cashier  User    @relation("CashCutCashier", fields: [cashierId], references: [id])
  closedBy User?   @relation("CashCutClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([tenantId, branchId, cashierId, cutDate, shift], name: "uq_cash_cut_scope")
  @@index([branchId])
  @@index([cashierId])
  @@index([closedById])
  @@map("cash_cuts")
}