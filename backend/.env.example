# Copia este archivo como .env (npm run dev lo hace solo si no existe).
# Esta URL coincide con el MySQL del docker-compose (docker compose up -d db).
# Si usas un MySQL propio, cambia usuario, contraseña y puerto.
# La base softlab_db no hace falta crearla: la crea prisma db push.
DATABASE_URL="mysql://root:78357Cas@localhost:3306/softlab_db"

PORT=4000

# Orígenes del frontend permitidos por CORS, separados por coma.
# Si se deja vacío, se aceptan todos.
ORIGENES_PERMITIDOS="http://localhost:5173,http://localhost:8080"
